@page "/"
@implements IDisposable
@inject IJSRuntime JS
@inject ILogger<Home> Logger

<div id="toolbar">
    <div class="panel">
        <div class="led" title="Mines left to flag">@game.MinesRemaining.ToString("000")</div>

        <button class="face" type="button" title="New game" @onclick="StartNewGame">@FaceGlyph</button>

        <div class="led" title="Time elapsed">@Clock</div>
    </div>

    <div class="levels">
        @foreach (var level in Levels)
        {
            <button class="level @(game.Difficulty == level ? "on" : null)" type="button"
                    @onclick="() => StartNewGame(level)">@level.ToString().ToUpperInvariant()</button>
        }
    </div>
</div>

<div id="board" tabindex="0"
     @oncontextmenu:preventDefault="true"
     @onkeydown="HandleKeyDown" @onkeydown:preventDefault="true">
    <BECanvas @ref="canvasRef" />
</div>

@code {
    // The host component owns the plumbing: it wires the JS animation frame loop and
    // browser events to the game, and nothing else. Rules go in Game/Minesweeper.cs.
    private readonly Minesweeper game = new();

    private BECanvasComponent canvasRef = default!;
    private CanvasDrawer? drawer;
    private DotNetObjectReference<Home>? selfRef;
    private bool faulted;
    private bool rendered;

    // The toolbar is the only markup that changes, so it drives rendering: the board is
    // painted imperatively and must not drag a render tree walk behind every click.
    private bool uiDirty;
    private GameState shownState = GameState.Playing;
    private int shownMines = -1;
    private int shownSeconds = -1;

    private static readonly Difficulty[] Levels =
        Enum.GetValues<Difficulty>();

    // Three digits and stuck there: the classic clock rolls at 999 rather than growing a
    // digit and shoving the rest of the toolbar sideways.
    private string Clock => Math.Min(999, (int)game.Elapsed.TotalSeconds).ToString("000");

    private string FaceGlyph => game.State switch
    {
        GameState.Won => "\U0001F60E",
        GameState.Lost => "\U0001F635",
        _ => "\U0001F642",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        rendered = true;
        drawer = new CanvasDrawer(await canvasRef.CreateCanvas2DAsync());
        selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("bMinesweeper.start", selfRef);
    }

    /// <summary>
    /// The viewport changed. The game is told in CSS pixels and never hears about the
    /// device pixel ratio — the canvas is scaled for it in JS.
    /// </summary>
    [JSInvokable]
    public void OnResize(double width, double height, double pixelRatio) =>
        game.Resize(width, height);

    /// <summary>
    /// A tap or left click: reveal. Pointer input is routed through JS rather than
    /// Blazor's @onclick because a touch device has to distinguish a tap from a press,
    /// and only the code holding the timer can tell them apart.
    /// </summary>
    [JSInvokable]
    public void OnTap(double x, double y) => game.OnClick(x, y);

    /// <summary>A right click or a long press: flag.</summary>
    /// <param name="x">Board x, in CSS pixels.</param>
    /// <param name="y">Board y, in CSS pixels.</param>
    /// <returns>What the press did, named for JS, which buzzes the phone accordingly.</returns>
    [JSInvokable]
    public string OnLongPress(double x, double y) => game.OnFlag(x, y).ToString();

    [JSInvokable]
    public async Task OnFrame(double timestampMs)
    {
        if (faulted || drawer is null)
        {
            return;
        }

        try
        {
            game.Update(TimeSpan.FromMilliseconds(timestampMs));

            // The face and the mine counter live in markup, so the frame loop is where a
            // win, a loss, or a re-dealt board gets noticed.
            int seconds = Math.Min(999, (int)game.Elapsed.TotalSeconds);

            if (game.State != shownState || game.MinesRemaining != shownMines || seconds != shownSeconds)
            {
                shownState = game.State;
                shownMines = game.MinesRemaining;
                shownSeconds = seconds;
                uiDirty = true;
                StateHasChanged();
            }

            // The board is static almost all the time and the canvas keeps the last frame,
            // so redrawing an unchanged board is pure waste.
            if (!game.NeedsRedraw)
            {
                return;
            }

            await drawer.Draw(game);
            game.MarkClean();
        }
        catch (Exception ex)
        {
            // Stop the loop on the first fault so the console isn't flooded with one copy
            // of the same exception per frame.
            faulted = true;
            Logger.LogError(ex, "Game loop faulted");
        }
    }

    private void StartNewGame() => game.NewGame();

    // Picking a level deals a new board: a board is defined by its mines, and sowing more
    // into a game in progress would rewrite what the player has already deduced.
    private void StartNewGame(Difficulty level)
    {
        game.NewGame(level);
        uiDirty = true;
    }

    private void HandleKeyDown(KeyboardEventArgs e) => game.OnKeyDown(e.Code);

    // Blazor re-renders a component after every event handler it owns, so without this each
    // tap and keystroke walks the render tree to produce the markup it produced last time.
    protected override bool ShouldRender()
    {
        if (!rendered || uiDirty)
        {
            uiDirty = false;
            return true;
        }

        return false;
    }

    public void Dispose() => selfRef?.Dispose();
}
